# Copy to .env and fill in. .env is gitignored -- never commit real values.

# TigerData / Timescale Cloud connection string (Service URL from the console).
# Looks like: postgresql://tsdbadmin:PASSWORD@xxxx.xxxx.tsdb.cloud.timescale.com:33333/tsdb?sslmode=require
DATABASE_URL=
# Optional trusted provider CA PEM; certificate and hostname verification stay enabled.
DATABASE_CA_FILE=

# Google Gemini API key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# Shared key the Flutter app sends as X-API-Key. Any long random string.
APP_API_KEY=dev-change-me

# Comma-separated origins for the Flutter web build. * is fine for the demo.
CORS_ORIGINS=*
