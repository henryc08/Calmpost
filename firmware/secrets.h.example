// Copy to secrets.h and fill in real values. secrets.h is gitignored --
// never commit real Wi-Fi credentials or device tokens.

#pragma once

// A phone hotspot works best: the ESP32 cannot join eduroam or any other
// WPA2-Enterprise network with this sketch, and campus Wi-Fi usually blocks
// device-to-device traffic anyway.
const char* WIFI_SSID     = "YOUR_HOTSPOT";
const char* WIFI_PASSWORD = "YOUR_HOTSPOT_PASSWORD";

// Base URL of the laptop running `uvicorn --host 0.0.0.0`, on the SAME
// network as this board. Changes per host laptop -- edit and reflash.
// Find it with `ipconfig` (Windows) or `ipconfig getifaddr en0` (mac).
const char* API_BASE      = "http://192.168.1.42:8000";

// Must match the bin registered in the backend.
const char* DEVICE_ID     = "bin-001";
// From: python -m scripts.init_db --bin bin-001 (shown once).
const char* DEVICE_TOKEN  = "PASTE_TOKEN_FROM_init_db";
