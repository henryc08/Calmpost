# Copy to .env (git-ignored). Never commit real keys.

# 0 = laptop webcam; or a video file / ESP32-CAM / Pi stream URL
CAMERA_SOURCE=0
BIN_ID=bin-001

# The real backend (backend/, uvicorn on 8000) has the /drops endpoints.
# Use http://localhost:8090 to run against mock_backend.py instead.
BACKEND_URL=http://localhost:8090
# Shared app key the backend checks in X-API-Key (leave empty for the mock)
APP_API_KEY=

# Google AI Studio key (https://aistudio.google.com/apikey)
GEMINI_API_KEY=
GEMINI_VISION_MODEL=gemini-2.5-flash

PREVIEW_PORT=8081
